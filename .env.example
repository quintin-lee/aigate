# Required
POSTGRES_PASSWORD=changeme
AIGATE_ADMIN_TOKEN=my-secret-admin-token

# Optional
# AIGATE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# AIGATE_UPSTREAM_TIMEOUT_MS=60000
# AIGATE_LISTEN=:8080
# AIGATE_USAGE_FLUSH_S=5
#   Daily token-quota rollover runs on the flush cycle, so the worst-case
#   delay between UTC midnight and a fresh quota is <= AIGATE_USAGE_FLUSH_S.
# AIGATE_MAX_BODY_BYTES=10485760
# AIGATE_METRICS_ACL=127.0.0.1
# AIGATE_ALLOW_PLAINTEXT_KEYS=0
# # Admin lockout policy (admin-auth brute-force guard); out-of-range values
# # keep the defaults (10 fails / 300 s). Lockout keys off the socket peer
# # IP, so behind a shared-IP reverse proxy the guard widens.
# AIGATE_LOCKOUT_MAX_FAILS=10
# AIGATE_LOCKOUT_WINDOW_S=300

# AIGATE_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/aigate_test
#   Local-run DSN (required by the gateway; compose path uses POSTGRES_PASSWORD instead).
# AIGATE_REDIS_URL=redis://127.0.0.1:6379
#   Empty/disabled by default; comment out to disable.
# AIGATE_REDIS_TIMEOUT_MS=100
#   Range [1,60000]; out-of-range silently falls back to 100.
# AIGATE_REDIS_POOL_SIZE=32
#   Range [1,512]; out-of-range silently falls back to 32.
# AIGATE_WORKER_THREADS=64
#   CivetWeb worker threads, default 64, range [4, 4096].
# AIGATE_REQUEST_TIMEOUT_MS=300000
#   CivetWeb request/stream timeout in ms, default 300000 (5m), range [1000, 3600000].
# AIGATE_TRUSTED_PROXIES=127.0.0.1
#   Comma-separated list of trusted proxy IPs/CIDRs for client IP extraction.
# AIGATE_DRAIN_TIMEOUT_S=15
#   Graceful shutdown drain duration in seconds, default 15, range [0, 120].
# AIGATE_REDIS_FAIL_OPEN=1
#   Fallback to local in-memory limiting on Redis outage (1=fail-open, 0=fail-closed).
# AIGATE_CORS_ALLOW_ORIGIN=*
#   Allowed CORS origin for web/SPA clients (e.g. * or https://chat.example.com).
# AIGATE_LOG_FORMAT=text
#   Log format: text (default for local dev) or json (structured for cloud-native/K8s/Loki).
# AIGATE_LOG_LEVEL=info
#   Minimum log level filter: debug, info (default), warn, error.
